# Referencia: el programa lee variables de la sesión, no carga este archivo .env.
# Opción predeterminada: Ollama local. Tener una clave no habilita la API.
LLM_PROVIDER=ollama
LLM_ALLOW_EXTERNAL_API=false
# Selección local explícita. Debe existir en ollama list; no se descarga ni cambia al fallar.
OLLAMA_MODEL=gemma3n:e2b

# Solo se consultan al seleccionar openai y habilitar expresamente el uso externo.
# Modelo compatible con Responses, por elegir cuando se necesite la API.
OPENAI_MODEL=
OPENAI_API_KEY=

# Para UNAB IA y el selector interactivo: scripts.start_interview.
# La clave se guarda en config/llm.local.json (ignorado por Git).
# Este .env.example sigue siendo solo referencia y no se carga automáticamente.
