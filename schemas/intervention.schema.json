{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intervención previa al candidato, versión de sesión 1.2.0",
  "description": "Etiquetas, política y referencias requieren además validación semántica con intervention_log.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intervention_number",
    "intervention_id",
    "before_question_number",
    "text",
    "received_at",
    "finished_at",
    "status",
    "available_context_turn_ids",
    "classification",
    "policy",
    "candidate_question_number",
    "issues"
  ],
  "properties": {
    "intervention_number": {
      "type": "integer",
      "minimum": 1
    },
    "intervention_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "before_question_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "text": {
      "type": "string"
    },
    "received_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "handled",
        "completed",
        "error",
        "incomplete",
        "interrupted"
      ]
    },
    "available_context_turn_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20
      }
    },
    "classification": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classifier_version",
            "strategy",
            "route",
            "status",
            "result",
            "trace"
          ],
          "properties": {
            "classifier_version": {
              "const": "1.0.0"
            },
            "strategy": {
              "const": "reglas_luego_llm"
            },
            "route": {
              "enum": [
                "reglas",
                "llm"
              ]
            },
            "status": {
              "enum": [
                "clasificada",
                "respaldo"
              ]
            },
            "result": {
              "type": "object"
            },
            "trace": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "local",
                "llm"
              ],
              "properties": {
                "local": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "reason_code",
                    "reason",
                    "considered_rule_ids",
                    "classifier_version"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "clasificada",
                        "abstencion"
                      ]
                    },
                    "reason_code": {
                      "enum": [
                        "regla_aplicada",
                        "contexto_requiere_interpretacion",
                        "estructura_no_soportada",
                        "conflicto_reglas",
                        "sin_regla_segura",
                        "restriccion_incompatible"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 600
                    },
                    "considered_rule_ids": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      }
                    },
                    "classifier_version": {
                      "const": "1.0.0"
                    }
                  }
                },
                "llm": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "classifier_version",
                        "prompt_sha256",
                        "status",
                        "attempts"
                      ],
                      "properties": {
                        "classifier_version": {
                          "enum": [
                            "1.0.0",
                            "1.1.0",
                            "1.2.0",
                            "1.2.1",
                            "1.2.2",
                            "1.2.3",
                            "1.3.0",
                            "1.4.0",
                            "1.4.1",
                            "1.4.2",
                            "1.5.0"
                          ]
                        },
                        "prompt_sha256": {
                          "type": "string",
                          "pattern": "^[0-9A-F]{64}$"
                        },
                        "status": {
                          "enum": [
                            "clasificada",
                            "respaldo"
                          ]
                        },
                        "attempts": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 2,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "number",
                              "status",
                              "error_code",
                              "input_tokens",
                              "output_tokens",
                              "elapsed_seconds",
                              "finish_reason"
                            ],
                            "properties": {
                              "number": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2
                              },
                              "status": {
                                "enum": [
                                  "validada",
                                  "json_invalido",
                                  "contrato_invalido",
                                  "error_proveedor"
                                ]
                              },
                              "error_code": {
                                "enum": [
                                  null,
                                  "json_invalido",
                                  "contrato_invalido",
                                  "authentication_error",
                                  "timeout",
                                  "connection_error",
                                  "context_limit",
                                  "model_not_found",
                                  "invalid_response",
                                  "provider_error",
                                  "llm_error",
                                  "unexpected_provider_error",
                                  "output_limit",
                                  "unexpected_finish"
                                ]
                              },
                              "input_tokens": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "output_tokens": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "elapsed_seconds": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "finish_reason": {
                                "enum": [
                                  null,
                                  "stop",
                                  "length",
                                  "completed",
                                  "otro"
                                ]
                              },
                              "validation_error": {
                                "type": [
                                  "object",
                                  "null"
                                ],
                                "additionalProperties": false,
                                "required": [
                                  "path",
                                  "rule",
                                  "message"
                                ],
                                "properties": {
                                  "path": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1000
                                  },
                                  "rule": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1000
                                  },
                                  "message": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 1000
                                  }
                                }
                              }
                            }
                          }
                        },
                        "llm_contract_version": {
                          "enum": [
                            "1.2.0",
                            "1.3.0"
                          ]
                        },
                        "aggregation_version": {
                          "enum": [
                            "1.0.0",
                            "1.1.0"
                          ]
                        },
                        "aggregation_applied": {
                          "type": "boolean"
                        },
                        "few_shot": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "enabled",
                            "version",
                            "case_ids",
                            "reference_sha256",
                            "examples_sha256"
                          ],
                          "properties": {
                            "enabled": {
                              "type": "boolean"
                            },
                            "version": {
                              "const": "1.0.0"
                            },
                            "case_ids": {
                              "type": "array",
                              "maxItems": 8,
                              "uniqueItems": true,
                              "items": {
                                "type": "string",
                                "pattern": "^R[0-9]{2}$"
                              }
                            },
                            "reference_sha256": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "pattern": "^[0-9A-F]{64}$"
                            },
                            "examples_sha256": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "pattern": "^[0-9A-F]{64}$"
                            }
                          },
                          "allOf": [
                            {
                              "if": {
                                "properties": {
                                  "enabled": {
                                    "const": true
                                  }
                                }
                              },
                              "then": {
                                "properties": {
                                  "case_ids": {
                                    "minItems": 1
                                  },
                                  "reference_sha256": {
                                    "type": "string"
                                  },
                                  "examples_sha256": {
                                    "type": "string"
                                  }
                                }
                              },
                              "else": {
                                "properties": {
                                  "case_ids": {
                                    "const": []
                                  },
                                  "reference_sha256": {
                                    "type": "null"
                                  },
                                  "examples_sha256": {
                                    "type": "null"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "classifier_version": {
                                "const": "1.3.0"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "llm_contract_version",
                              "aggregation_version",
                              "aggregation_applied"
                            ],
                            "properties": {
                              "llm_contract_version": {
                                "const": "1.2.0"
                              },
                              "aggregation_version": {
                                "const": "1.0.0"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "classifier_version": {
                                "const": "1.4.0"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "llm_contract_version",
                              "aggregation_version",
                              "aggregation_applied"
                            ],
                            "properties": {
                              "llm_contract_version": {
                                "const": "1.3.0"
                              },
                              "aggregation_version": {
                                "const": "1.1.0"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "classifier_version": {
                                "const": "1.4.1"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "llm_contract_version",
                              "aggregation_version",
                              "aggregation_applied"
                            ],
                            "properties": {
                              "llm_contract_version": {
                                "const": "1.3.0"
                              },
                              "aggregation_version": {
                                "const": "1.1.0"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "classifier_version": {
                                "const": "1.4.2"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "llm_contract_version",
                              "aggregation_version",
                              "aggregation_applied"
                            ],
                            "properties": {
                              "llm_contract_version": {
                                "const": "1.3.0"
                              },
                              "aggregation_version": {
                                "const": "1.1.0"
                              }
                            }
                          }
                        },
                        {
                          "if": {
                            "properties": {
                              "classifier_version": {
                                "const": "1.5.0"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "llm_contract_version",
                              "aggregation_version",
                              "aggregation_applied",
                              "few_shot"
                            ],
                            "properties": {
                              "llm_contract_version": {
                                "const": "1.3.0"
                              },
                              "aggregation_version": {
                                "const": "1.1.0"
                              }
                            }
                          }
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_version",
            "action",
            "code",
            "text",
            "candidate_metadata"
          ],
          "properties": {
            "policy_version": {
              "const": "1.0.0"
            },
            "action": {
              "enum": [
                "responder",
                "aclarar",
                "no_evaluable",
                "error_tecnico"
              ]
            },
            "code": {
              "enum": [
                "clasificacion_clara",
                "contexto_o_intencion_insuficiente",
                "entrada_no_evaluable",
                "fallo_clasificacion"
              ]
            },
            "text": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidate_metadata": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_question_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 20
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "error_type",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/issue_code"
        },
        "error_type": {
          "$ref": "#/$defs/text"
        },
        "message": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "issue_code": {
      "enum": [
        "profile_integrity_error",
        "interrupted",
        "authentication_error",
        "timeout",
        "connection_error",
        "context_limit",
        "model_not_found",
        "invalid_response",
        "provider_error",
        "llm_error",
        "unexpected_error",
        "summary_selection_error"
      ]
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "context_pairs",
        "characters_per_message",
        "requested_provider",
        "requested_model",
        "max_output_tokens"
      ],
      "properties": {
        "policy_version": {
          "const": "1.0.0"
        },
        "context_pairs": {
          "const": 2
        },
        "characters_per_message": {
          "const": 1200
        },
        "requested_provider": {
          "enum": [
            null,
            "ollama",
            "openai",
            "unab"
          ]
        },
        "requested_model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 16,
          "maximum": 4096
        }
      }
    }
  }
}
