{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "applicability",
    "reason",
    "evidence",
    "criteria",
    "feedback",
    "discrepancies"
  ],
  "properties": {
    "contract_version": {
      "const": "1.2.0"
    },
    "applicability": {
      "enum": [
        "evaluable",
        "no_evaluable"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "evidence": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "turn_number",
              "quote"
            ],
            "properties": {
              "source": {
                "const": "question"
              },
              "turn_number": {
                "type": "null"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "turn_number",
              "quote"
            ],
            "properties": {
              "source": {
                "enum": [
                  "context_question",
                  "context_answer"
                ]
              },
              "turn_number": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            }
          }
        ]
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pertinencia",
        "enfoque",
        "claridad",
        "neutralidad"
      ],
      "properties": {
        "pertinencia": {
          "$ref": "#/$defs/criterion"
        },
        "enfoque": {
          "$ref": "#/$defs/criterion"
        },
        "claridad": {
          "$ref": "#/$defs/criterion"
        },
        "neutralidad": {
          "$ref": "#/$defs/criterion"
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "suggestion",
        "reformulation"
      ],
      "properties": {
        "criterion": {
          "enum": [
            null,
            "pertinencia",
            "enfoque",
            "claridad",
            "neutralidad"
          ]
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "\\S"
            }
          ]
        },
        "reformulation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 220,
              "pattern": "\\S"
            }
          ]
        }
      }
    },
    "discrepancies": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "alternative",
          "reason",
          "quote"
        ],
        "properties": {
          "field": {
            "enum": [
              "approaches",
              "forms",
              "attributes",
              "evaluability"
            ]
          },
          "alternative": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250,
            "pattern": "\\S"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "evidence_ids",
            "reason"
          ],
          "properties": {
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 110,
              "pattern": "\\S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "evidence_ids",
            "reason"
          ],
          "properties": {
            "level": {
              "type": "null"
            },
            "evidence_ids": {
              "type": "array",
              "maxItems": 0
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 110,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
