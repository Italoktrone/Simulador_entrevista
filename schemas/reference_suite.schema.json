{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conjunto de referencia para consistencia del candidato",
  "description": "Casos de desarrollo con fuentes y criterios humanos; no contiene respuestas generadas, puntuaciones ni etiquetas de calidad de preguntas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "suite_id", "candidate_id", "job_id", "scenario_reference_date", "candidate_source_sha256", "review_mode", "usage", "case_isolation", "cases"],
  "properties": {
    "suite_version": {"const": "1.0.0"},
    "suite_id": {"type": "string", "pattern": "^consistencia-[a-z0-9]+(?:-[a-z0-9]+)*$", "not": {"pattern": "\\s"}},
    "candidate_id": {"$ref": "#/$defs/text"},
    "job_id": {"$ref": "#/$defs/text"},
    "scenario_reference_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "candidate_source_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9A-F]{64}$"},
    "review_mode": {"const": "human_factual_review"},
    "usage": {"const": "development_reference"},
    "case_isolation": {"const": "new_session_per_case"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "fact_id": {"type": "string", "pattern": "^fact-[a-z0-9]+(?:-[a-z0-9]+)*$", "not": {"pattern": "\\s"}},
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "label", "source", "path", "criterion"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/fact_id"},
        "label": {"$ref": "#/$defs/text"},
        "source": {"enum": ["candidate_profile", "temporal_facts"]},
        "path": {"type": "array", "minItems": 1, "items": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "integer", "minimum": 0}]}},
        "criterion": {"enum": ["required_content", "consistency_constraint"]}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_number", "question", "expected_fact_ids"],
      "properties": {
        "step_number": {"type": "integer", "minimum": 1, "maximum": 20},
        "question": {"$ref": "#/$defs/text"},
        "expected_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fact_id"}}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "title", "steps", "reference_facts", "review_notes"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^cons-[a-z0-9]+(?:-[a-z0-9]+)*$", "not": {"pattern": "\\s"}},
        "title": {"$ref": "#/$defs/text"},
        "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/step"}},
        "reference_facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "review_notes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    }
  }
}
