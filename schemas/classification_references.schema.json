{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Referencias humanas aprobadas de clasificación, conjunto inicial",
  "description": "Envoltura del conjunto 1.0.0. El cargador valida configuración y expected con sus contratos compartidos.",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite_version", "suite_id", "classification_contract_version", "approval", "usage", "case_isolation", "base_configuration", "cases"],
  "properties": {
    "suite_version": {"const": "1.0.0"},
    "suite_id": {"const": "clasificacion-basica-001"},
    "classification_contract_version": {"const": "1.0.0"},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "decision", "source_document", "source_version"],
      "properties": {
        "status": {"const": "approved_by_user"},
        "decision": {"const": "Apruebo"},
        "source_document": {"const": "docs/metodologia/referencias-clasificacion-propuesta.md"},
        "source_version": {"const": "1.0.0"}
      }
    },
    "usage": {"const": "development_and_known_check"},
    "case_isolation": {"const": "independent_context_per_case"},
    "base_configuration": {"type": "object"},
    "cases": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "message": {
      "type": "object", "additionalProperties": false, "required": ["role", "content"],
      "properties": {"role": {"enum": ["user", "assistant"]}, "content": {"$ref": "#/$defs/text"}}
    },
    "context_turn": {
      "type": "object", "additionalProperties": false, "required": ["turn_number", "messages"],
      "properties": {
        "turn_number": {"type": "integer", "minimum": 1},
        "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "split", "difficulty", "input", "context_note", "expected"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^R[0-9]{2}$"},
        "split": {"enum": ["desarrollo", "comprobacion_conocida"]},
        "difficulty": {"enum": ["baja", "media", "alta"]},
        "context_note": {"$ref": "#/$defs/text"},
        "input": {
          "type": "object", "additionalProperties": false,
          "required": ["text", "configuration_overrides", "context_turns", "competency"],
          "properties": {
            "text": {"type": "string"},
            "configuration_overrides": {
              "type": "object", "additionalProperties": false,
              "properties": {"approach": {"enum": ["conductual", "situacional", "mixto"]}}
            },
            "context_turns": {"type": "array", "items": {"$ref": "#/$defs/context_turn"}},
            "competency": {"type": "null"}
          }
        },
        "expected": {"type": "object"}
      }
    }
  }
}
